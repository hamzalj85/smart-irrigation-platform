# Normalise everything to LF inside the repository, whatever the machine.
* text=auto eol=lf

# Scripts that must stay LF (they are executed on Linux)
*.sh        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf

# Windows scripts
*.ps1       text eol=crlf

# Binaries: never touch
*.png       binary
*.jpg       binary
*.gif       binary
*.pdf       binary
*.parquet   binary
